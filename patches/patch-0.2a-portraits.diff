+  // Nicknames that come from the face and kit, so the name fits the picture.
+  function faceNicknames(t) {
+    const n = [];
+    if (t.hair === '#9a3f20') n.push('Red', 'Rusty');
+    if (t.glasses) n.push('Specs', 'Prof');
+    if (t.hairStyle === 'bald' && t.head === 'bare') n.push('Baldy');
+    if (t.cig) n.push('Smokes');
+    if (t.moustache === 'handlebar' || t.moustache === 'walrus') n.push('Whiskers');
+    if (t.beard) n.push('Beard');
+    if (t.scar || t.plaster || t.head === 'bandage') n.push('Lucky');
+    if (t.mouth === 'grin') n.push('Sunny');
+    if (t.hair === '#b4b1aa' || t.hair === '#7d7b76') n.push('Pops');
+    if (t.head === 'ushanka') n.push('Bear');
