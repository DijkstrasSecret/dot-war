+// Dot War: procedural soldier portraits.
+//
+// Every soldier gets a small face built from a seed (for example the unit id).
+// The same seed always gives the same face, so a soldier keeps his face for the
+// whole match.
+//
+// Visual only: this file has its own random stream and never touches the
+// simulation's seeded stream, so portraits can never change a match's outcome
+// (CLAUDE.md: "purely visual randomness uses a separate stream").
+//
+// Usage:
+//   Portraits.svg(seed, { team: '#4a7fb5', size: 64 })  -> SVG markup string
+//   Portraits.dataURL(seed, opts)                        -> data: URL for <img> or canvas
+//   Portraits.image(seed, opts)                          -> cached Image for ctx.drawImage
+//   Portraits.traits(seed)                               -> the face description object
+//   Portraits.name(seed, { faction, era, rank: 0-3 })    -> { short: 'Pvt. Kowalski', full: 'Pvt. Jan "Red" Kowalski', ... }
+//   Portraits.svg(seed, { team, faction: 'german', era: 'ww2' | 'cold' | 'modern' })
+//                                                        -> faction kit; faces stay the same
+//   Portraits.seedFor(matchSeed, unitId)                 -> a stable numeric seed
+(function (root) {
+  'use strict';
+
+  // ---------- random helpers ----------
+
+  function mulberry32(seed) {
+    let a = seed >>> 0;
+    return function () {
+      a = (a + 0x6D2B79F5) >>> 0;
+      let t = a;
+      t = Math.imul(t ^ (t >>> 15), t | 1);
+      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+  }
+
+  function hash(str) {
+    let h = 2166136261 >>> 0;
+    for (let i = 0; i < str.length; i++) {
+      h ^= str.charCodeAt(i);
+      h = Math.imul(h, 16777619);
+    }
+    return h >>> 0;
+  }
+
+  function toSeed(seed) {
+    return typeof seed === 'number' ? (seed >>> 0) : hash(String(seed));
+  }
+
+  const pick = (r, arr) => arr[Math.floor(r() * arr.length)];
+  const range = (r, a, b) => a + r() * (b - a);
+  const chance = (r, p) => r() < p;
+  function weighted(r, table) {
+    let total = 0;
+    for (const row of table) total += row[1];
+    let x = r() * total;
+    for (const row of table) { x -= row[1]; if (x < 0) return row[0]; }
+    return table[table.length - 1][0];
+  }
+
+  // Lighten (f > 0) or darken (f < 0) a #rrggbb colour.
+  function shade(hex, f) {
+    const n = parseInt(hex.slice(1), 16);
+    const t = f < 0 ? 0 : 255, p = Math.abs(f);
+    const mix = c => Math.round((t - c) * p + c);
+    const r = mix(n >> 16), g = mix((n >> 8) & 255), b = mix(n & 255);
+    return '#' + ((1 << 24) | (r << 16) | (g << 8) | b).toString(16).slice(1);
+  }
+
+  const f1 = n => Math.round(n * 10) / 10;
+
+  // ---------- palettes (1910-1945 look, no national insignia) ----------
+
+  const SKIN = ['#f3d4b6', '#eabf98', '#dca77a', '#c98d5c', '#b07444', '#915a33', '#6f4326', '#51301b'];
+  const HAIR = [
+    ['#1c1410', 5], ['#2f2119', 5], ['#4a3222', 4], ['#6b4a2c', 3], ['#8e6b40', 2],
+    ['#b8925a', 1.5], ['#d6bd86', 1], ['#9a3f20', 1], ['#7d7b76', 0.8], ['#b4b1aa', 0.4]
+  ];
+  const UNIFORM = ['#5b6340', '#857650', '#636b62', '#6e5539', '#58636f', '#40503a', '#7a6f55'];
+  const HELMET = ['#4d5538', '#5c6150', '#6b6147', '#464b45', '#57604a', '#5f6a6e', '#3f4636'];
+  const KNIT = ['#4b4a45', '#6b5a44', '#3d4a5a', '#5a3b33', '#55573f'];
+  const SCARF = ['#8c7b62', '#5f5a4c', '#a39a84', '#6b4b3a', '#4a5560'];
+
+  const HELMETS = ['brodie', 'coal', 'm1', 'adrian', 'modern'];
+  // Headgear that hides the top of the hair
+  const COVERS = HELMETS.concat(['beanie', 'peaked', 'fieldcap', 'ushanka', 'boonie', 'beret']);
+
+  // ---------- traits ----------
+
+  function traits(seed) {
+    const r = mulberry32(toSeed(seed));
+    const t = {};
+    t.skin = pick(r, SKIN);
+    t.hair = weighted(r, HAIR);
+    t.uniform = pick(r, UNIFORM);
+    t.helmetColor = pick(r, HELMET);
+    t.knit = pick(r, KNIT);
+    t.scarfColor = pick(r, SCARF);
+
+    t.fw = range(r, 10.5, 13);        // half face width
+    t.fh = range(r, 11.5, 14);        // eye line to chin
+    t.jaw = range(r, 3, 8);           // chin width
+    t.jawK = range(r, 0.45, 0.8);     // how square the jaw is
+    t.shoulders = range(r, 23, 28);
+    t.eyeY = range(r, 29.5, 31);
+    t.eyeGap = range(r, 4.3, 5.8);
+    t.hairline = range(r, 17, 19.5);
+
+    t.eyes = weighted(r, [['dot', 6], ['squint', 2], ['wide', 1]]);
+    t.brows = weighted(r, [['flat', 4], ['stern', 4], ['worried', 2], ['raised', 1]]);
+    t.browW = range(r, 1.1, 2.2);
+    t.nose = weighted(r, [['line', 4], ['wide', 2], ['hook', 2], ['button', 2]]);
+    t.mouth = weighted(r, [['flat', 5], ['frown', 3], ['smirk', 2], ['open', 1], ['grin', 1]]);
+    t.mouthW = range(r, 2.5, 4.5);
+
+    t.head = weighted(r, [
+      ['brodie', 3], ['coal', 3], ['m1', 3], ['adrian', 2], ['sidecap', 2],
+      ['peaked', 1], ['beanie', 1], ['bandage', 1], ['bare', 2]
+    ]);
+    t.hairStyle = weighted(r, [['crop', 4], ['part', 3], ['buzz', 3], ['swept', 2], ['receding', 1], ['bald', 1]]);
+
+    t.stubble = chance(r, 0.35);
+    t.moustache = weighted(r, [['none', 7], ['pencil', 1], ['brush', 2], ['handlebar', 1], ['walrus', 1]]);
+    t.beard = chance(r, 0.08);
+    t.scar = chance(r, 0.12) ? pick(r, ['cheek', 'brow', 'chin']) : null;
+    t.plaster = chance(r, 0.08);
+    t.glasses = chance(r, 0.07);
+    t.cig = chance(r, 0.08) && t.mouth !== 'open';
+    t.strap = chance(r, 0.6);         // unused (chin straps removed); kept so faces stay the same
+    t.net = chance(r, 0.25);
+    t.goggles = chance(r, 0.08);
+    t.webbing = chance(r, 0.5);
+    t.tabs = chance(r, 0.55);
+    t.scarf = chance(r, 0.12);
+    t.bg = range(r, -0.08, 0.08);
+
+    t.dirt = [];
+    if (chance(r, 0.3)) {
+      const n = 1 + Math.floor(r() * 3);
+      for (let i = 0; i < n; i++) t.dirt.push([range(r, 22, 42), range(r, 30, 42), range(r, 1.2, 2.8)]);
+    }
+    t.leaves = [];
+    if (chance(r, 0.15)) {
+      const n = 3 + Math.floor(r() * 4);
+      for (let i = 0; i < n; i++) t.leaves.push([range(r, -10, 10), range(r, -9, -1), range(r, 0, 180)]);
+    }
+    return t;
+  }
+
+  // ---------- factions and kit ----------
+  //
+  // Factions change looks only (DESIGN_DECISIONS K): every side still plays the same.
+  // A faction sets the uniform, the headgear and most of the names. The era ('ww2',
+  // 'cold', 'modern') is fixed when the soldier is trained, from the player's research,
+  // so veterans keep their old kit.
+  //
+  // Kit table fields: h = headgear weights, u = plain uniform colours, hc = helmet
+  // colours, camo = uniform camouflage { base, spots, shape }, cover = camouflage cover
+  // on helmets (true = same as the uniform), beret = beret colours, net / leaves /
+  // goggles = chances.
+
+  const ERAS = ['ww2', 'cold', 'modern'];
+  const EXTRAS = [['peaked', 0.4], ['bandage', 0.4], ['bare', 0.6]];
+  const H = pairs => pairs.concat(EXTRAS);
+
+  const FACTIONS = {
+    british: { label: 'British', pool: 'british', neighbours: ['american', 'french', 'polish'], kit: {
+      ww2:    { h: H([['brodie', 7], ['beret', 2], ['sidecap', 1], ['beanie', 1]]), u: ['#7a6a45', '#6e5f3e'], hc: ['#5a5a3c', '#4f5236'], beret: ['#6b2d2d', '#3e3a2c', '#2d2f3a'], net: 0.35, leaves: 0.15 },
+      cold:   { h: H([['m1', 4], ['brodie', 1], ['beret', 3], ['boonie', 1], ['beanie', 1]]), camo: { base: '#6b6a44', spots: ['#3f3a2a', '#7a5a3a', '#3b4a2e'] }, hc: ['#4a4d38'], beret: ['#6b2d2d', '#2d2f3a', '#4a5238'], net: 0.5, leaves: 0.3 },
+      modern: { h: H([['modern', 6], ['boonie', 2], ['beret', 1.5], ['fieldcap', 1]]), camo: { base: '#8a7d5c', spots: ['#5c5a3e', '#6e5c42', '#b0a07a'] }, cover: true, beret: ['#6b2d2d', '#4a5238'] }
+    } },
+    american: { label: 'American', pool: 'american', neighbours: ['british', 'polish', 'italian'], kit: {
+      ww2:    { h: H([['m1', 8], ['sidecap', 1], ['fieldcap', 0.6], ['beanie', 1]]), u: ['#5b5a3b', '#6b6444', '#7a6f52'], hc: ['#4f5436', '#565a3e'], net: 0.25 },
+      cold:   { h: H([['m1', 7], ['fieldcap', 2], ['boonie', 2], ['beanie', 0.5]]), u: ['#5a5d3e', '#55583a'], cover: { base: '#5f6445', spots: ['#3b4a2e', '#6b5a3a', '#2a2a22'] }, leaves: 0.25 },
+      modern: { h: H([['modern', 6], ['boonie', 2], ['fieldcap', 2], ['beret', 0.5]]), camo: { base: '#8b8566', spots: ['#5e6547', '#9c8a64', '#4a4034'] }, cover: true, beret: ['#2a2a2a', '#6b2d2d', '#3e4a3a'] }
+    } },
+    french: { label: 'French', pool: 'french', neighbours: ['british', 'polish', 'spanish'], kit: {
+      ww2:    { h: H([['adrian', 7], ['sidecap', 2], ['beret', 1]]), u: ['#8a7d58', '#7d7353'], hc: ['#6b6a52', '#5f6150'], beret: ['#2f3550'], net: 0.1 },
+      cold:   { h: H([['m1', 5], ['beret', 3], ['fieldcap', 1]]), u: ['#68674a', '#626144'], hc: ['#55583f'], beret: ['#2f3550', '#3e4a3a', '#6b2d2d'], net: 0.3 },
+      modern: { h: H([['modern', 6], ['boonie', 1.5], ['beret', 1.5], ['fieldcap', 1]]), camo: { base: '#6d6b48', spots: ['#3a3a2a', '#7a5e3c', '#4c5a38'] }, cover: true, beret: ['#2f3550', '#3e4a3a'] }
+    } },
+    german: { label: 'German', pool: 'german', neighbours: ['polish', 'italian', 'french'], kit: {
+      ww2:    { h: H([['coal', 7], ['fieldcap', 2.5], ['sidecap', 1]]), u: ['#5e6457', '#646a5c', '#575d52'], hc: ['#4f5449', '#5a5f52', '#55584a'], net: 0.1, leaves: 0.25 },
+      cold:   { h: H([['m1', 5], ['fieldcap', 3], ['beret', 1.5]]), u: ['#5f6149', '#5a5c45'], hc: ['#4f5436'], beret: ['#3e4a3a', '#2a2a2a', '#6b2d2d'], net: 0.4, leaves: 0.2 },
+      modern: { h: H([['modern', 6], ['boonie', 1.5], ['fieldcap', 1.5], ['beret', 1]]), camo: { base: '#6f7550', spots: ['#3a4a2c', '#5a4a34', '#2a2a22', '#8a8a5c'], shape: 'dot' }, cover: true, beret: ['#3e4a3a', '#2a2a2a'] }
+    } },
+    italian: { label: 'Italian', pool: 'italian', neighbours: ['german', 'spanish', 'french'], kit: {
+      ww2:    { h: H([['m1', 6], ['sidecap', 3]]), u: ['#6d6e55', '#747259'], hc: ['#6a6a50', '#5f6148'] },
+      cold:   { h: H([['m1', 5], ['beret', 2], ['fieldcap', 1], ['sidecap', 1]]), u: ['#606249'], hc: ['#55583f'], beret: ['#2a2a2a', '#6b2d2d', '#3e4a3a'], net: 0.3 },
+      modern: { h: H([['modern', 6], ['boonie', 1.5], ['beret', 1.5], ['fieldcap', 1]]), camo: { base: '#71694a', spots: ['#4a5536', '#5a4632', '#2f2f26'] }, cover: true, beret: ['#2a2a2a', '#6b2d2d'] }
+    } },
+    polish: { label: 'Polish', pool: 'polish', neighbours: ['french', 'british', 'soviet'], kit: {
+      ww2:    { h: H([['m1', 5], ['sidecap', 2], ['coal', 0.5]]), u: ['#6b6848', '#65633f'], hc: ['#565a3e', '#4f5436'] },
+      cold:   { h: H([['m1', 5], ['beret', 2], ['sidecap', 1], ['ushanka', 1]]), camo: { base: '#6a6a50', spots: ['#8a7a5a', '#4a4a36'], shape: 'dot' }, hc: ['#4f5436'], beret: ['#6b2d2d', '#2a2a2a'] },
+      modern: { h: H([['modern', 6], ['boonie', 1.5], ['beret', 1.5], ['fieldcap', 1]]), camo: { base: '#6a6a48', spots: ['#3f4a2e', '#5a4633', '#2c2a24'] }, cover: true, beret: ['#6b2d2d', '#2a2a2a'] }
+    } },
+    soviet: { label: 'Soviet', pool: 'soviet', neighbours: ['polish', 'turkish'], kit: {
+      ww2:    { h: H([['m1', 5], ['sidecap', 4], ['ushanka', 2]]), u: ['#6f6a47', '#76704c', '#66623f'], hc: ['#4d5a3a', '#56613f'] },
+      cold:   { h: H([['m1', 5], ['sidecap', 3], ['ushanka', 3], ['beret', 1]]), u: ['#6a6645'], hc: ['#4d5a3a'], beret: ['#5b87b0', '#2a2a2a'] },
+      modern: { h: H([['modern', 6], ['ushanka', 1], ['beret', 1], ['fieldcap', 1.5], ['boonie', 1]]), camo: { base: '#6f6e52', spots: ['#4a5238', '#5e4f3b', '#2d2c26'], shape: 'square' }, cover: true, beret: ['#5b87b0', '#2a2a2a'] }
+    } },
+    turkish: { label: 'Turkish', pool: 'turkish', neighbours: ['soviet', 'italian'], kit: {
+      ww2:    { h: H([['coal', 6], ['sidecap', 2]]), u: ['#6e6a4a', '#75704d'], hc: ['#5c5f48', '#55583f'] },
+      cold:   { h: H([['m1', 6], ['fieldcap', 2], ['beret', 1], ['sidecap', 1]]), u: ['#5f6149'], hc: ['#4f5436'], beret: ['#6b2d2d', '#2a2a2a'] },
+      modern: { h: H([['modern', 6], ['boonie', 1], ['fieldcap', 2], ['beret', 1]]), camo: { base: '#72705a', spots: ['#4d5a3f', '#6b5b45', '#35332c'], shape: 'square' }, cover: true, beret: ['#6b2d2d', '#2a2a2a'] }
+    } },
+    spanish: { label: 'Spanish', pool: 'spanish', neighbours: ['french', 'italian'], kit: {
+      ww2:    { h: H([['m1', 3], ['adrian', 1], ['sidecap', 2], ['beret', 1.5]]), u: ['#7d6f4c', '#6f6446'], hc: ['#5f6048', '#56583f'], beret: ['#1f1f24', '#7a2424'] },
+      cold:   { h: H([['m1', 5], ['beret', 2], ['sidecap', 2], ['fieldcap', 1]]), u: ['#6a6a4a'], hc: ['#55583f'], beret: ['#1f1f24', '#3e4a3a'] },
+      modern: { h: H([['modern', 6], ['boonie', 1], ['beret', 1.5], ['fieldcap', 1.5]]), camo: { base: '#7a7456', spots: ['#4f5a3c', '#6b5a42', '#35322a'], shape: 'square' }, cover: true, beret: ['#1f1f24', '#3e4a3a'] }
+    } }
+  };
+
+  // The kit one soldier wears: faction + era + his own seed.
+  function kit(seed, faction, era) {
+    const F = FACTIONS[faction];
+    if (!F) return null;
+    if (!F.kit[era]) era = 'ww2';
+    const K = F.kit[era];
+    const r = mulberry32(toSeed(seed) ^ hash(faction + '/' + era));
+    const k = { faction, era };
+    k.head = weighted(r, K.h);
+    k.uniform = K.camo ? K.camo.base : pick(r, K.u);
+    k.helmetColor = pick(r, K.hc || ['#4f5436']);
+    k.beretColor = pick(r, K.beret || ['#2d2f3a']);
+    k.fur = pick(r, ['#5a4a3a', '#6b5a44', '#3f3a33', '#7a6a55']);
+    k.net = chance(r, K.net || 0);
+    k.goggles = chance(r, K.goggles != null ? K.goggles : (era === 'modern' ? 0.3 : 0.08));
+    k.nvg = era === 'modern' && chance(r, 0.4);
+    k.leaves = [];
+    if (chance(r, K.leaves != null ? K.leaves : 0.1)) {
+      const n = 3 + Math.floor(r() * 4);
+      for (let i = 0; i < n; i++) k.leaves.push([range(r, -10, 10), range(r, -9, -1), range(r, 0, 180)]);
+    }
+    const spots = (def, n, x0, x1, y0, y1) => {
+      const shape = def.shape || 'blob';
+      const size = shape === 'dot' ? [0.7, 1.3] : shape === 'square' ? [1.2, 2.4] : [1.6, 3.6];
+      const a = [];
+      for (let i = 0; i < (shape === 'dot' ? n * 2 : n); i++) {
+        a.push([range(r, x0, x1), range(r, y0, y1), range(r, size[0], size[1]), Math.floor(r() * def.spots.length)]);
+      }
+      return a;
+    };
+    k.camo = null;
+    k.cover = null;
+    if (K.camo) {
+      k.camo = { shape: K.camo.shape || 'blob', colors: K.camo.spots,
+        spots: spots(K.camo, 34, 2, 62, 45, 64), head: spots(K.camo, 16, 12, 52, 2, 34) };
+    }
+    const coverDef = K.cover === true ? K.camo : K.cover;
+    if (coverDef) {
+      k.cover = { shape: coverDef.shape || 'blob', colors: coverDef.spots, head: spots(coverDef, 16, 12, 52, 2, 34) };
+      k.helmetColor = coverDef.base;
+    }
+    return k;
+  }
+
+  function camoSpots(list, colors, shape) {
+    return list.map(s => shape === 'square'
+      ? `<rect x="${f1(s[0])}" y="${f1(s[1])}" width="${f1(s[2])}" height="${f1(s[2])}" fill="${colors[s[3]]}"/>`
+      : `<ellipse cx="${f1(s[0])}" cy="${f1(s[1])}" rx="${f1(s[2])}" ry="${f1(s[2] * 0.65)}" fill="${colors[s[3]]}"/>`).join('');
+  }
+
+  // ---------- drawing ----------
+
+  let uid = 0;
+
+  function svg(seed, opts) {
+    opts = opts || {};
+    const t = traits(seed);
+    // With a faction, the kit replaces the random uniform and headgear (the face stays).
+    if (opts.faction && FACTIONS[opts.faction]) Object.assign(t, kit(seed, opts.faction, opts.era));
+    const size = opts.size || 64;
+    const team = opts.team || '#4a7fb5';
+    const id = 'dwp' + (uid++).toString(36);
+
+    const L = 32 - t.fw, R = 32 + t.fw, C = 30 + t.fh;
+    const skinD = shade(t.skin, -0.18);
+    const hairD = shade(t.hair, -0.25);
+    const uniD = shade(t.uniform, -0.3);
+    const hc = t.helmetColor, hcD = shade(hc, -0.28), hcL = shade(hc, 0.18);
+    const lip = shade(t.skin, -0.5);
+    const out = [];
+    const p = s => out.push(s);
+
+    const headPath =
+      `M${f1(L)} 29 C${f1(L)} ${f1(29 - t.fw * 1.45)} ${f1(R)} ${f1(29 - t.fw * 1.45)} ${f1(R)} 29 ` +
+      `L${f1(R)} 31 C${f1(R)} ${f1(31 + t.fh * t.jawK)} ${f1(32 + t.jaw)} ${f1(C)} 32 ${f1(C)} ` +
+      `C${f1(32 - t.jaw)} ${f1(C)} ${f1(L)} ${f1(31 + t.fh * t.jawK)} ${f1(L)} 31 Z`;
+
+    // Every helmet and cap is sized from this head: its width (L..R) and the top of the
+    // skull (hT). Brims never come down past the eyebrows.
+    const hT = 29 - t.fw * 1.0875;                     // highest point of the skull
+    const browTop = t.eyeY - 5;                        // lowest a brim may sit
+    const brimAt = d => Math.min(hT + d, browTop);
+    // A dome from x0 to x1, standing on `bottom`, whose highest point is `peak`.
+    const domeShape = (x0, x1, bottom, peak) => {
+      const c = bottom - (bottom - peak) / 0.75;
+      return `M${f1(x0)} ${f1(bottom)} C${f1(x0)} ${f1(c)} ${f1(x1)} ${f1(c)} ${f1(x1)} ${f1(bottom)} Z`;
+    };
+    const covers = COVERS.indexOf(t.head) >= 0;
+
+    let dome = null, brimY = null, peak = null;
+    if (t.head === 'brodie') { brimY = brimAt(5);   peak = hT - 3.5; dome = domeShape(L + 0.5, R - 0.5, brimY, peak); }
+    if (t.head === 'coal')   { brimY = brimAt(8);   peak = hT - 4;   dome = domeShape(L - 1.5, R + 1.5, brimY, peak); }
+    if (t.head === 'm1')     { brimY = brimAt(8);   peak = hT - 4;   dome = domeShape(L - 2, R + 2, brimY, peak); }
+    if (t.head === 'adrian') { brimY = brimAt(7);   peak = hT - 3.5; dome = domeShape(L - 0.5, R + 0.5, brimY, peak); }
+    if (t.head === 'sidecap' || t.head === 'peaked') brimY = brimAt(5);
+    if (t.head === 'beanie') brimY = brimAt(6.5);
+    if (t.head === 'modern') {
+      // Modern combat helmet: round dome with sides that come down over the ears
