+    if (F) Object.assign(t, kit(seed, opts.faction, opts.era));
+    const fromFace = faceNicknames(t);
+    let nickname = null;
+    if (fromFace.length && chance(r, 0.45)) nickname = pick(r, fromFace);
+    else if (chance(r, 0.06)) nickname = pick(r, PLAIN_NICKNAMES);
+    const title = opts.title || RANK_TITLES[Math.max(0, Math.min(3, opts.rank || 0))];
+    return {
+      first, last, nickname, title,
+      nation: pool.label,                                  // where the name comes from
+      volunteer: !!F && key !== F.pool,                    // serving in another nation's army
